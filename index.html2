<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Business Receptionist V2</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f6f9;color:#172033}
header{background:#111827;color:white;padding:15px 20px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:20}
.logo{font-size:21px;font-weight:bold}.logo span{color:#60a5fa}
.menu-btn,.btn{border:0;border-radius:9px;padding:11px 16px;background:#2563eb;color:white;font-weight:bold;cursor:pointer}
.container{max-width:1150px;margin:auto;padding:20px}
.hero{background:linear-gradient(135deg,#2563eb,#7c3aed);color:white;padding:35px 25px;border-radius:18px;margin-bottom:20px}
.hero h1{font-size:30px;margin-bottom:10px}.hero p{line-height:1.6;opacity:.92}
.tabs{display:flex;gap:8px;overflow-x:auto;margin-bottom:20px}
.tab{border:0;padding:11px 15px;border-radius:10px;background:white;cursor:pointer;white-space:nowrap}
.tab.active{background:#2563eb;color:white}
.section{display:none}.section.active{display:block}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.card{background:white;border-radius:15px;padding:20px;box-shadow:0 4px 15px rgba(0,0,0,.06);margin-bottom:18px}
.stat{font-size:28px;font-weight:bold;margin-top:8px}
label{display:block;margin:12px 0 6px;font-weight:bold}
input,textarea,select{width:100%;padding:12px;border:1px solid #d1d5db;border-radius:9px;font-size:15px}
textarea{min-height:100px;resize:vertical}
.chat-box{height:390px;overflow-y:auto;background:#eef2ff;padding:15px;border-radius:12px}
.msg{max-width:82%;padding:11px 14px;margin-bottom:10px;border-radius:12px;line-height:1.5;white-space:pre-line}
.bot{background:white}.user{background:#2563eb;color:white;margin-left:auto}
.chat-input{display:flex;gap:8px;margin-top:10px}.chat-input input{flex:1}
table{width:100%;border-collapse:collapse}
th,td{padding:11px;border-bottom:1px solid #e5e7eb;text-align:left}
.badge{display:inline-block;padding:5px 9px;border-radius:20px;background:#dcfce7;color:#166534;font-size:12px}
.empty{text-align:center;padding:30px;color:#6b7280}
.whatsapp{background:#16a34a!important}
.delete{background:#dc2626!important;padding:7px 10px!important}
.small{font-size:13px;color:#64748b;margin-top:5px}
@media(max-width:750px){.grid{grid-template-columns:repeat(2,1fr)}.hero h1{font-size:24px}table{font-size:13px}th,td{padding:8px}}
@media(max-width:480px){.container{padding:12px}.grid{gap:10px}.card{padding:15px}}
</style>
</head>

<body>

<header>
<div class="logo">AI <span>Receptionist V2</span></div>
<button class="menu-btn" onclick="showSection('dashboard')">Dashboard</button>
</header>

<div class="container">

<div class="hero">
<h1>आपका Smart AI Receptionist 🤖</h1>
<p>Customer enquiries, appointments और business information को एक जगह manage करें।</p>
<br>
<button class="btn whatsapp" onclick="openWhatsApp()">💬 WhatsApp</button>
</div>

<div class="tabs">
<button class="tab active" onclick="showSection('dashboard',this)">Dashboard</button>
<button class="tab" onclick="showSection('setup',this)">Business Setup</button>
<button class="tab" onclick="showSection('chat',this)">AI Chat</button>
<button class="tab" onclick="showSection('appointments',this)">Appointments</button>
<button class="tab" onclick="showSection('customers',this)">Customers</button>
</div>

<section id="dashboard" class="section active">

<div class="grid">

<div class="card">
<div>Appointments</div>
<div class="stat" id="statAppointments">0</div>
</div>

<div class="card">
<div>Customers</div>
<div class="stat" id="statCustomers">0</div>
</div>

<div class="card">
<div>AI Chats</div>
<div class="stat" id="statChats">0</div>
</div>

<div class="card">
<div>Status</div>
<div class="stat" style="font-size:18px">
<span class="badge">● Online</span>
</div>
</div>

</div>

<div class="card">
<h2>Business Overview</h2><br>
<p><b>Business:</b> <span id="dashBusiness">Demo Business</span></p><br>
<p><b>Category:</b> <span id="dashCategory">Service</span></p><br>
<p><b>Phone:</b> <span id="dashPhone">Not Added</span></p><br>
<p><b>Hours:</b> <span id="dashHours">Not Added</span></p>
</div>

</section>

<section id="setup" class="section">

<div class="card">
<h2>Business Setup 🏢</h2>

<label>Business Name</label>
<input id="businessName" placeholder="Sharma Salon">

<label>Business Category</label>
<select id="businessCategory">
<option>Salon</option>
<option>Doctor / Clinic</option>
<option>Restaurant</option>
<option>Real Estate</option>
<option>Coaching</option>
<option>Shop</option>
<option>Other</option>
</select>

<label>Business Phone</label>
<input id="businessPhone" placeholder="9876543210">

<label>WhatsApp Number</label>
<input id="whatsappNumber" placeholder="919876543210">
<div class="small">Country code सहित डालें, जैसे 919876543210</div>

<label>Business Address</label>
<textarea id="businessAddress" placeholder="Business का पूरा पता"></textarea>

<label>Opening Time</label>
<input type="time" id="openingTime">

<label>Closing Time</label>
<input type="time" id="closingTime">

<label>Services & Prices</label>
<textarea id="services" placeholder="Haircut - ₹200
Hair Spa - ₹500
Facial - ₹700"></textarea>

<button class="btn" onclick="saveBusiness()">Save Business</button>
</div>

</section>

<section id="chat" class="section">

<div class="card">
<h2>AI Receptionist 🤖</h2><br>

<div class="chat-box" id="chatBox">
<div class="msg bot">नमस्ते! 👋 मैं आपका AI Receptionist हूँ।
आप price, timing, address या appointment के बारे में पूछ सकते हैं।</div>
</div>

<div class="chat-input">
<input id="chatInput" placeholder="ग्राहक का सवाल..."
onkeydown="if(event.key==='Enter')sendMessage()">
<button class="btn" onclick="sendMessage()">Send</button>
</div>

</div>

</section>

<section id="appointments" class="section">

<div class="card">
<h2>नई Appointment 📅</h2>

<label>Customer Name</label>
<input id="customerName" placeholder="ग्राहक का नाम">

<label>Mobile Number</label>
<input id="customerPhone" placeholder="मोबाइल नंबर">

<label>Date</label>
<input type="date" id="appointmentDate">

<label>Time</label>
<input type="time" id="appointmentTime">

<label>Service</label>
<input id="appointmentService" placeholder="Haircut">

<button class="btn" onclick="addAppointment()">Confirm Appointment</button>
</div>

<div class="card">
<h2>Appointments</h2><br>
<div id="appointmentList"></div>
</div>

</section>

<section id="customers" class="section">

<div class="card">
<h2>Customers 👥</h2><br>
<div id="customerList"></div>
</div>

</section>

</div>

<script>

let data=JSON.parse(localStorage.getItem("airV2"))||{
business:{},
appointments:[],
customers:[],
chats:0
};

function saveData(){
localStorage.setItem("airV2",JSON.stringify(data));
}

function showSection(id,button){

document.querySelectorAll(".section")
.forEach(x=>x.classList.remove("active"));

document.getElementById(id).classList.add("active");

document.querySelectorAll(".tab")
.forEach(x=>x.classList.remove("active"));

if(button)button.classList.add("active");

updateDashboard();
}

function saveBusiness(){

data.business={
name:businessName.value,
category:businessCategory.value,
phone:businessPhone.value,
whatsapp:whatsappNumber.value,
address:businessAddress.value,
opening:openingTime.value,
closing:closingTime.value,
services:services.value
};

saveData();
updateDashboard();

alert("Business information save हो गई ✅");
}

function updateDashboard(){

statAppointments.innerText=data.appointments.length;
statCustomers.innerText=data.customers.length;
statChats.innerText=data.chats;

dashBusiness.innerText=data.business.name||"Demo Business";
dashCategory.innerText=data.business.category||"Service";
dashPhone.innerText=data.business.phone||"Not Added";

dashHours.innerText=
data.business.opening&&data.business.closing
?data.business.opening+" - "+data.business.closing
:"Not Added";

renderAppointments();
renderCustomers();
}

function sendMessage(){

let input=chatInput;
let text=input.value.trim();

if(!text)return;

addChatMessage(text,"user");

data.chats++;

let reply=getAIReply(text);

setTimeout(()=>addChatMessage(reply,"bot"),350);

input.value="";
saveData();
updateDashboard();
}

function addChatMessage(text,type){

let div=document.createElement("div");
div.className="msg "+type;
div.innerText=text;

chatBox.appendChild(div);
chatBox.scrollTop=chatBox.scrollHeight;
}

function getAIReply(message){

let m=message.toLowerCase();
let b=data.business;

if(m.includes("price")||m.includes("कीमत")||m.includes("रेट")||m.includes("दाम"))
return b.services?"Services & Prices:\n\n"+b.services:"Business Setup में services और prices add करें।";

if(m.includes("time")||m.includes("समय")||m.includes("खुले"))
return b.opening&&b.closing
?"Business timing: "+b.opening+" से "+b.closing
:"Business Setup में timing add करें।";

if(m.includes("address")||m.includes("पता")||m.includes("location")||m.includes("कहाँ"))
return b.address?"Address: "+b.address:"Business Setup में address add करें।";

if(m.includes("appointment")||m.includes("booking")||m.includes("बुक")||m.includes("अपॉइंटमेंट"))
return "ज़रूर! Appointments section में जाकर customer की booking करें।";

if(m.includes("hello")||m.includes("hi")||m.includes("नमस्ते"))
return "नमस्ते! 👋 मैं आपकी मदद के लिए तैयार हूँ।";

return "धन्यवाद! 😊 आपकी enquiry प्राप्त हुई। हम जल्द आपकी मदद करेंगे।";
}

function addAppointment(){

let name=customerName.value.trim();
let phone=customerPhone.value.trim();
let date=appointmentDate.value;
let time=appointmentTime.value;
let service=appointmentService.value.trim();

if(!name||!phone||!date||!time){
alert("Name, Mobile, Date और Time भरें।");
return;
}

data.appointments.push({name,phone,date,time,service});

if(!data.customers.some(c=>c.phone===phone)){
data.customers.push({name,phone,service});
}

saveData();
updateDashboard();

customerName.value="";
customerPhone.value="";
appointmentDate.value="";
appointmentTime.value="";
appointmentService.value="";

alert("Appointment Confirm हो गई ✅");
}

function deleteAppointment(index){

if(confirm("Appointment delete करें?")){
data.appointments.splice(index,1);
saveData();
updateDashboard();
}
}

function deleteCustomer(index){

if(confirm("Customer delete करें?")){
data.customers.splice(index,1);
saveData();
updateDashboard();
}
}

function renderAppointments(){

if(data.appointments.length===0){
appointmentList.innerHTML='<div class="empty">अभी कोई appointment नहीं है।</div>';
return;
}

let html="<table><tr><th>नाम</th><th>मोबाइल</th><th>तारीख</th><th>समय</th><th>Service</th><th></th></tr>";

data.appointments.forEach((a,i)=>{
html+=`<tr>
<td>${safe(a.name)}</td>
<td>${safe(a.phone)}</td>
<td>${safe(a.date)}</td>
<td>${safe(a.time)}</td>
<td>${safe(a.service||"-")}</td>
<td><button class="btn delete" onclick="deleteAppointment(${i})">Delete</button></td>
</tr>`;
});

appointmentList.innerHTML=html+"</table>";
}

function renderCustomers(){

if(data.customers.length===0){
customerList.innerHTML='<div class="empty">अभी कोई customer नहीं है।</div>';
return;
}

let html="<table><tr><th>नाम</th><th>मोबाइल</th><th>Service</th><th></th></tr>";

data.customers.forEach((c,i)=>{
html+=`<tr>
<td>${safe(c.name)}</td>
<td>${safe(c.phone)}</td>
<td>${safe(c.service||"-")}</td>
<td><button class="btn delete" onclick="deleteCustomer(${i})">Delete</button></td>
</tr>`;
});

customerList.innerHTML=html+"</table>";
}

function safe(v){
return String(v)
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");
}

function openWhatsApp(){

let number=data.business.whatsapp||data.business.phone;

if(!number){
alert("पहले Business Setup में WhatsApp Number डालें।");
return;
}

number=number.replace(/\D/g,"");

window.open(
"https://wa.me/"+number+
"?text="+encodeURIComponent("नमस्ते, मुझे आपके business के बारे में जानकारी चाहिए।"),
"_blank"
);
}

function loadBusiness(){

let b=data.business;

businessName.value=b.name||"";
businessCategory.value=b.category||"Salon";
businessPhone.value=b.phone||"";
whatsappNumber.value=b.whatsapp||"";
businessAddress.value=b.address||"";
openingTime.value=b.opening||"";
closingTime.value=b.closing||"";
services.value=b.services||"";
}

loadBusiness();
updateDashboard();

</script>

</body>
  </html>
